{%- style -%}
  .ing-section-{{ section.id }} {
    position: relative;
    padding: var(--sec-y) 0;
  }
  .ing-section-{{ section.id }} .sec-pad {
    padding: clamp(26px, 3.4vw, 40px);
    border-radius: 24px;
    overflow: hidden;
  }
  .ing-section-{{ section.id }} .panel-head {
    text-align: center;
    margin-bottom: 26px;
  }
  .ing-section-{{ section.id }} .panel-head .d2 {
    margin-bottom: 12px;
  }
  .ing-section-{{ section.id }} .panel-head .rule {
    margin: 0 auto;
    justify-content: center;
    max-width: 240px;
  }
  .ing-section-{{ section.id }} .panel-head .rule i:first-child {
    background: linear-gradient(90deg, transparent, rgba(236, 230, 247, 0.44));
  }
  .ing-section-{{ section.id }} .ing {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0;
  }
  @media (min-width: 760px) {
    .ing-section-{{ section.id }} .ing {
      grid-template-columns: repeat(5, 1fr);
    }
  }
  .ing-section-{{ section.id }} .ing-i {
    text-align: center;
    padding: 16px 12px;
    position: relative;
  }
  @media (min-width: 760px) {
    .ing-section-{{ section.id }} .ing-i + .ing-i::before {
      content: "";
      position: absolute;
      left: 0;
      top: 14%;
      bottom: 14%;
      width: 1px;
      background: linear-gradient(180deg, transparent, rgba(236, 230, 247, 0.24), transparent);
    }
  }
  .ing-section-{{ section.id }} .ing-i .art {
    height: 88px;
    display: grid;
    place-items: center;
    margin-bottom: 12px;
  }
  .ing-section-{{ section.id }} .ing-i .art svg {
    height: 84px;
    width: auto;
  }
  .ing-section-{{ section.id }} .ing-i h4 {
    font-family: 'Outfit', sans-serif;
    font-size: 12.5px;
    font-weight: 700;
    letter-spacing: .11em;
    text-transform: uppercase;
    color: var(--surface);
    margin-bottom: 6px;
  }
  .ing-section-{{ section.id }} .ing-i p {
    font-size: 12.2px;
    color: var(--paper-2);
    line-height: 1.5;
  }
{%- endstyle -%}

