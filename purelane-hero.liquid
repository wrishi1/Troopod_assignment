<section class="hero" id="top" data-scene="1">
  <div class="hero-grid">

    <div class="badges glass-2" aria-label="Product promises">
      <div class="badge">
        <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg></span>
        <span>Plant<br>powered</span>
      </div>
      <div class="badge">
        <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg></span>
        <span>Safe for<br>kids &amp; pets</span>
      </div>
      <div class="badge">
        <span class="bi"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg></span>
        <span>Zero harsh<br>chemicals</span>
      </div>
    </div>

    <div class="hero-copy">
      <h1 class="d1 rv in">{{ section.settings.heading_line_1 | default: "Clean" }}<br>{{ section.settings.heading_line_2 | default: "That" }}<br><span class="lime">{{ section.settings.heading_line_3 | default: "Lasts" }}</span></h1>
      <div class="rule rv rv-d1">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
      <p class="lede rv rv-d2">{{ section.settings.subheading | default: "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it." }}</p>
      <div class="hero-cta rv rv-d3">
        <a class="btn btn-primary" href="{{ section.settings.primary_button_link | default: routes.root_url | append: '#shop' }}">{{ section.settings.primary_button_label | default: "Shop now" }}
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h13m-5-6 6 6-6 6"/></svg>
        </a>
        <a class="btn btn-ghost" href="{{ section.settings.secondary_button_link | default: routes.root_url | append: '#how' }}">{{ section.settings.secondary_button_label | default: "How it works" }}</a>
      </div>

      <div class="badgestrip rv rv-d4">
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
          Plant powered
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3 4.5 6v6.2c0 4.3 3.1 7.6 7.5 8.8 4.4-1.2 7.5-4.5 7.5-8.8V6L12 3Z"/><path d="m9 12 2.2 2.2L15.4 10"/></svg>
          Kids &amp; pet safe
        </div>
        <div class="glass-2">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="8.4"/><path d="M6.4 17.6 17.6 6.4"/></svg>
          Zero harsh chem
        </div>
      </div>
    </div>

    <div class="hero-prod" id="heroProd">
      <div class="hstage" id="hstage">
        {% assign featured_collection = collections[section.settings.collection] | default: collections.all %}
        {% for product in featured_collection.products limit: 3 %}
          <div class="hslide hs{{ forloop.index }} {% if forloop.first %}on{% endif %}" data-n="{{ forloop.index }}">
            <img 
              src="{{ product.featured_image | image_url: width: 400 }}" 
              alt="{{ product.title | escape }}" 
              class="hp-real-img"
              loading="lazy"
            >
            <div class="glass-2 ptag">
              <span class="lbl">{{ product.title | truncate: 18 }}</span>
              <span class="val">
                <strong>{{ product.price | money }}</strong>
                {% if product.compare_at_price > product.price %}
                  <s>{{ product.compare_at_price | money }}</s>
                {% endif %}
              </span>
              {% if product.compare_at_price > product.price %}
                {% assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                <span class="cut">{{ savings }}% OFF</span>
              {% endif %}
            </div>
          </div>
        {% endfor %}
      </div>
      <div class="hdots" id="hdots">
        <button type="button" class="on" aria-label="Show product 1" data-target="1"></button>
        <button type="button" class="" aria-label="Show product 2" data-target="2"></button>
        <button type="button" class="" aria-label="Show product 3" data-target="3"></button>
      </div>
    </div>

  </div>
</section>

{% stylesheet %}
:root {
  --maxw: 1180px;
  --accent-gold: #c67d26;
  --sec-y: 60px;
  --bg-mint: #dceee4;
  --text-dark: #1b1c2e;
  --text-muted: #52635a;
  --btn-green: #074e40;
  --icon-green: #2e5944;
}

/* Glass Surface Utility */
.glass-2 {
  background: rgba(255, 255, 255, 0.45);
  backdrop-filter: blur(16px);
  -webkit-backdrop-filter: blur(16px);
  border: 1px solid rgba(255, 255, 255, 0.7);
  box-shadow: 0 8px 32px rgba(0, 0, 0, 0.04);
}

.hero {
  position: relative;
  z-index: 2;
  min-height: 100vh;
  display: flex;
  align-items: center;
  padding: 100px 0 var(--sec-y);
  background: radial-gradient(circle at 60% 40%, #eef7f2 0%, var(--bg-mint) 70%, #cadfc1 100%);
  overflow: hidden;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
}

.hero::before {
  content: "";
  position: absolute;
  inset: 0;
  z-index: 1;
  pointer-events: none;
  background: radial-gradient(circle at 80% 20%, rgba(255, 255, 255, 0.5) 0%, transparent 60%);
}

.hero-grid {
  max-width: var(--maxw);
  margin: 0 auto;
  padding: 0 24px;
  width: 100%;
  position: relative;
  z-index: 2;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.hero-copy {
  max-width: 520px;
  position: relative;
  z-index: 3;
}

.badges { display: none !important; }

.hero h1 {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(3rem, 6.5vw, 5rem);
  font-weight: 900;
  line-height: 0.95;
  color: var(--text-dark);
  margin-bottom: 12px;
  letter-spacing: -0.02em;
  text-transform: uppercase;
}

.hero h1 .lime { color: var(--accent-gold); }
.rule { display: none; }

.hero .lede {
  font-size: 1rem;
  line-height: 1.55;
  color: var(--text-muted);
  max-width: 440px;
  margin-top: 24px;
}

.hero-cta {
  display: flex;
  gap: 14px;
  align-items: center;
  margin-top: 32px;
}

.btn {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 8px;
  padding: 14px 28px;
  border-radius: 999px;
  font-size: 11px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  text-decoration: none;
  transition: all 0.3s ease;
  cursor: pointer;
}

.btn-primary {
  background: var(--btn-green);
  color: #ffffff;
  border: 1px solid var(--btn-green);
  box-shadow: 0 8px 20px rgba(7, 78, 64, 0.2);
}

.btn-primary:hover {
  background: #04362c;
  transform: translateY(-2px);
}

.btn-primary svg { width: 14px; height: 14px; }

.btn-ghost {
  background: rgba(255, 255, 255, 0.8);
  color: var(--btn-green);
  border: 1px solid rgba(255, 255, 255, 0.9);
}

.badgestrip {
  position: absolute;
  top: 50%;
  right: -130px;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 22px;
  padding: 28px 18px;
  width: 110px;
  z-index: 15;
  border-radius: 28px;
  background: rgba(255, 255, 255, 0.35);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  border: 1.5px solid rgba(255, 255, 255, 0.75);
  box-shadow: 0 16px 36px rgba(0, 0, 0, 0.05);
}

.badgestrip .glass-2 {
  background: transparent !important;
  border: none !important;
  box-shadow: none !important;
  backdrop-filter: none !important;
  -webkit-backdrop-filter: none !important;
  display: flex;
  flex-direction: column;
  align-items: center;
  text-align: center;
  padding: 0;
  font-size: 8.5px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #3e4843;
  line-height: 1.3;
}

.badgestrip .glass-2 svg {
  width: 16px;
  height: 16px;
  margin-bottom: 8px;
  color: var(--icon-green);
  padding: 8px;
  border-radius: 50%;
  border: 1.5px solid var(--icon-green);
  background: rgba(255, 255, 255, 0.4);
}

.hero-prod {
  position: relative;
  width: 420px;
  height: 460px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
}

.hstage { width: 100%; height: 100%; position: relative; }

.hslide {
  display: none;
  width: 100%;
  height: 100%;
  position: absolute;
  inset: 0;
}

.hslide.on {
  display: flex;
  align-items: center;
  justify-content: center;
}

.hp-real-img {
  max-height: 360px;
  width: auto;
  object-fit: contain;
  filter: drop-shadow(0 16px 24px rgba(0, 0, 0, 0.12));
  transition: transform 0.4s ease;
}

.hslide.on .hp-real-img {
  transform: scale(1.05);
}

.ptag {
  position: absolute;
  left: -20px;
  bottom: 20px;
  z-index: 12;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
  padding: 12px 16px;
  border-radius: 14px;
  background: rgba(255, 255, 255, 0.6) !important;
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  border: 1px solid rgba(255, 255, 255, 0.8) !important;
  box-shadow: 0 12px 28px rgba(0,0,0,0.06);
}

.ptag .lbl {
  font-size: 9px;
  font-weight: 800;
  text-transform: uppercase;
  letter-spacing: 0.1em;
  color: var(--accent-gold);
  margin-bottom: 2px;
}

.ptag .val { display: flex; align-items: baseline; gap: 6px; }

.ptag .val strong {
  font-family: 'Outfit', sans-serif;
  font-size: 18px;
  font-weight: 800;
  color: var(--text-dark);
}

.ptag .val s { font-size: 11px; color: var(--text-muted); }

.ptag .cut {
  margin-top: 4px;
  background: rgba(198, 125, 38, 0.15);
  color: var(--accent-gold);
  font-size: 9px;
  font-weight: 800;
  padding: 2px 6px;
  border-radius: 4px;
  text-transform: uppercase;
}

.hdots {
  position: absolute;
  bottom: -20px;
  display: flex;
  gap: 6px;
}

.hdots button {
  width: 8px;
  height: 8px;
  border-radius: 999px;
  border: none;
  background: rgba(27, 28, 46, 0.2);
  cursor: pointer;
  padding: 0;
  transition: all 0.3s ease;
}

.hdots button.on {
  background: var(--accent-gold);
  width: 20px;
}

/* Header sticky animation handling */
header, 
.header, 
#header, 
.site-header,
.header-wrapper {
  position: fixed !important;
  top: 0 !important;
  left: 0 !important;
  right: 0 !important;
  z-index: 999 !important;
  transform: translateY(-100%);
  transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1) !important;
}

header.header-visible,
.header.header-visible,
#header.header-visible,
.site-header.header-visible,
.header-wrapper.header-visible {
  transform: translateY(0) !important;
}

@media (max-width: 990px) {
  .hero-grid { 
    flex-direction: column; 
    text-align: center; 
    padding-top: 40px; 
  }

  .hero-copy { max-width: 100%; }
  .hero .lede { margin: 16px auto; }
  .hero-cta { justify-content: center; }
  
  .hero-prod { 
    margin-top: 40px; 
    width: 100%; 
    max-width: 360px; 
  }

  .badgestrip {
    position: relative;
    right: auto;
    top: auto;
    transform: none;
    flex-direction: row;
    width: 100%;
    max-width: 380px;
    justify-content: space-around;
    margin: 32px auto 0;
    padding: 16px 12px;
  }

  .ptag {
    left: 50%;
    transform: translateX(-50%);
  }
}
{% endstylesheet %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  // Product Switcher
  const dots = document.querySelectorAll('#hdots button');
  const slides = document.querySelectorAll('#hstage .hslide');

  dots.forEach(dot => {
    dot.addEventListener('click', () => {
      const targetN = dot.getAttribute('data-target');
      
      dots.forEach(d => d.classList.remove('on'));
      slides.forEach(s => s.classList.remove('on'));

      dot.classList.add('on');
      const targetSlide = document.querySelector(`#hstage .hslide[data-n="${targetN}"]`);
      if (targetSlide) targetSlide.classList.add('on');
    });
  });

  // Sticky Header Scroll Controller
  const themeHeader = document.querySelector('header, .header, #header, .site-header, .header-wrapper');
  const heroSection = document.getElementById('top');

  if (themeHeader && heroSection) {
    const checkScroll = () => {
      const heroBottom = heroSection.getBoundingClientRect().bottom;
      if (heroBottom <= 80) {
        themeHeader.classList.add('header-visible');
      } else {
        themeHeader.classList.remove('header-visible');
      }
    };

    window.addEventListener('scroll', checkScroll, { passive: true });
    checkScroll();
  }
});
</script>

{% schema %}
{
  "name": "Purelane Hero",
  "settings": [
    { "type": "collection", "id": "collection", "label": "Select Collection" },
    { "type": "text", "id": "heading_line_1", "label": "Heading line 1", "default": "Clean" },
    { "type": "text", "id": "heading_line_2", "label": "Heading line 2", "default": "That" },
    { "type": "text", "id": "heading_line_3", "label": "Heading line 3 (highlighted)", "default": "Lasts" },
    { "type": "textarea", "id": "subheading", "label": "Subheading", "default": "Homecare that works on the toughest grime, made from plants. Kind to your home, your family and the world outside it." },
    { "type": "text", "id": "primary_button_label", "label": "Primary button label", "default": "Shop now" },
    { "type": "url", "id": "primary_button_link", "label": "Primary button link" },
    { "type": "text", "id": "secondary_button_label", "label": "Secondary button label", "default": "How it works" },
    { "type": "url", "id": "secondary_button_link", "label": "Secondary button link" }
  ],
  "presets": [
    { "name": "Purelane Hero" }
  ]
}
{% endschema %}