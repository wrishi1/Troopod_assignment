<div class="purelane-combos section-{{ section.id }}" id="combos">
  <div class="wrap">
    <div class="panel-head text-center">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      <h2 class="d2">{{ section.settings.heading | escape }}</h2>
    </div>

    <div class="combo-grid">
      {%- for block in section.blocks -%}
        {%- assign p1 = all_products[block.settings.product_1] -%}
        {%- assign p2 = all_products[block.settings.product_2] -%}

        <div class="combo-card" {{ block.shopify_attributes }}>
          <div class="combo-visual">
            <div class="combo-img">
              {%- if p1.featured_media -%}
                <img src="{{ p1.featured_media | image_url: width: 300 }}" alt="{{ p1.title | escape }}" loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <span class="plus-icon">+</span>
            <div class="combo-img">
              {%- if p2.featured_media -%}
                <img src="{{ p2.featured_media | image_url: width: 300 }}" alt="{{ p2.title | escape }}" loading="lazy">
              {%- else -%}
                {{ 'product-2' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
          </div>

          <div class="combo-details">
            <span class="combo-badge">{{ block.settings.badge_text | default: "Save Extra" }}</span>
            <h3>{{ block.settings.title | default: "Value Bundle" }}</h3>

            {%- if p1 != blank and p2 != blank -%}
              {%- assign combined_price = p1.price | plus: p2.price -%}
              <div class="pr">
                <strong>{{ combined_price | money }}</strong>
                {%- if block.settings.discount_note != blank -%}
                  <em>{{ block.settings.discount_note }}</em>
                {%- endif -%}
              </div>
              <button
                type="button"
                class="btn btn-primary bundle-add"
                data-v1="{{ p1.selected_or_first_available_variant.id }}"
                data-v2="{{ p2.selected_or_first_available_variant.id }}"
              >
                Add Combo to Cart
              </button>
            {%- else -%}
              <div class="pr"><strong>Select products in customizer</strong></div>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }} {
    position: relative;
    padding: 80px 0;
    background: linear-gradient(135deg, #eef2ff 0%, #f5e9ff 45%, #e6f7f1 100%);
    overflow: hidden;
  }

  /* Soft blurred color blobs behind the glass cards give them something to refract */
  .section-{{ section.id }}::before,
  .section-{{ section.id }}::after {
    content: "";
    position: absolute;
    border-radius: 50%;
    filter: blur(80px);
    z-index: 0;
    pointer-events: none;
  }
  .section-{{ section.id }}::before {
    width: 420px;
    height: 420px;
    top: -120px;
    left: -100px;
    background: radial-gradient(circle, rgba(129,140,248,0.35), transparent 70%);
  }
  .section-{{ section.id }}::after {
    width: 480px;
    height: 480px;
    bottom: -160px;
    right: -120px;
    background: radial-gradient(circle, rgba(52,211,153,0.30), transparent 70%);
  }

  .section-{{ section.id }} .wrap {
    position: relative;
    z-index: 1;
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .section-{{ section.id }} .panel-head {
    text-align: center;
    margin-bottom: 40px;
  }
  .section-{{ section.id }} .kicker {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: #5b5b7a;
    display: block;
    margin-bottom: 8px;
    font-weight: 600;
  }
  .section-{{ section.id }} h2.d2 {
    font-size: 30px;
    font-weight: 800;
    margin: 0;
    color: #1a1a2e;
    letter-spacing: -0.02em;
  }

  .section-{{ section.id }} .combo-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 28px;
  }

  /* Core glassmorphism card */
  .section-{{ section.id }} .combo-card {
    position: relative;
    background: rgba(255, 255, 255, 0.45);
    backdrop-filter: blur(18px) saturate(160%);
    -webkit-backdrop-filter: blur(18px) saturate(160%);
    border: 1px solid rgba(255, 255, 255, 0.6);
    border-radius: 20px;
    padding: 28px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    box-shadow:
      0 8px 32px rgba(31, 38, 135, 0.12),
      inset 0 1px 0 rgba(255, 255, 255, 0.7);
    transition: transform 0.35s ease, box-shadow 0.35s ease, background 0.35s ease;
  }
  .section-{{ section.id }} .combo-card:hover {
    transform: translateY(-6px);
    background: rgba(255, 255, 255, 0.6);
    box-shadow:
      0 16px 40px rgba(31, 38, 135, 0.18),
      inset 0 1px 0 rgba(255, 255, 255, 0.8);
  }

  /* Subtle top sheen for extra "glass" realism */
  .section-{{ section.id }} .combo-card::before {
    content: "";
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 50%;
    background: linear-gradient(180deg, rgba(255,255,255,0.35), transparent);
    border-radius: 20px 20px 0 0;
    pointer-events: none;
  }

  .section-{{ section.id }} .combo-visual {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    margin-bottom: 22px;
    width: 100%;
    position: relative;
    z-index: 1;
  }
  .section-{{ section.id }} .combo-img {
    width: 110px;
    height: 110px;
    background: rgba(255, 255, 255, 0.5);
    backdrop-filter: blur(6px);
    border: 1px solid rgba(255, 255, 255, 0.7);
    border-radius: 14px;
    overflow: hidden;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 14px rgba(31, 38, 135, 0.08);
  }
  .section-{{ section.id }} .combo-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .section-{{ section.id }} .plus-icon {
    font-size: 20px;
    font-weight: 700;
    color: #6b6b8d;
  }

  .section-{{ section.id }} .combo-details {
    position: relative;
    z-index: 1;
    width: 100%;
  }

  .section-{{ section.id }} .combo-badge {
    background: rgba(52, 211, 153, 0.18);
    color: #1b7a4d;
    border: 1px solid rgba(52, 211, 153, 0.35);
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    padding: 5px 12px;
    border-radius: 20px;
    display: inline-block;
    margin-bottom: 10px;
  }

  .section-{{ section.id }} h3 {
    font-size: 19px;
    margin: 4px 0 12px;
    font-weight: 700;
    color: #1a1a2e;
  }

  .section-{{ section.id }} .pr {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    margin-bottom: 18px;
    flex-wrap: wrap;
  }
  .section-{{ section.id }} .pr strong {
    font-size: 19px;
    color: #1a1a2e;
  }
  .section-{{ section.id }} .pr em {
    color: #1b7a4d;
    font-style: normal;
    font-size: 13px;
    font-weight: 600;
  }

  .section-{{ section.id }} .btn {
    width: 100%;
    padding: 13px;
    background: rgba(17, 17, 17, 0.9);
    backdrop-filter: blur(4px);
    color: #fff;
    border: 1px solid rgba(255, 255, 255, 0.15);
    border-radius: 10px;
    font-weight: 600;
    cursor: pointer;
    transition: background 0.25s ease, transform 0.25s ease;
  }
  .section-{{ section.id }} .btn:hover {
    background: #000;
    transform: translateY(-1px);
  }

  /* Graceful fallback for browsers without backdrop-filter support */
  @supports not (backdrop-filter: blur(1px)) {
    .section-{{ section.id }} .combo-card {
      background: rgba(255, 255, 255, 0.92);
    }
    .section-{{ section.id }} .combo-img {
      background: #f7f7f7;
    }
  }
</style>

{% schema %}
{
  "name": "Purelane Combos",
  "tag": "section",
  "class": "purelane-combos-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Subheading",
      "default": "Better Together"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Custom Combos & Bundles"
    }
  ],
  "blocks": [
    {
      "type": "combo",
      "name": "Combo Pair",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Combo Name",
          "default": "Starter Clean Set"
        },
        {
          "type": "text",
          "id": "badge_text",
          "label": "Badge Text",
          "default": "Save 15%"
        },
        {
          "type": "product",
          "id": "product_1",
          "label": "First Product"
        },
        {
          "type": "product",
          "id": "product_2",
          "label": "Second Product"
        },
        {
          "type": "text",
          "id": "discount_note",
          "label": "Discount Callout",
          "default": "Inclusive of Bundle Discount"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Combos",
      "blocks": [
        { "type": "combo" },
        { "type": "combo" }
      ]
    }
  ]
}
{% endschema %}