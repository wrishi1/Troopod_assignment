<style>
/* =========================================================
   PURELANE CUSTOM HEADER
   Original HTML/Liquid structure preserved
   ========================================================= */

/* Smooth scrolling */
html {
  scroll-behavior: smooth;
}

/* Scroll offset */
section,
div[id],
[id] {
  scroll-margin-top: 110px;
}

/* =========================================================
   HEADER
   ========================================================= */

#hdr {
  position: fixed !important;
  top: 16px !important;
  left: 0 !important;
  right: 0 !important;
  width: 100% !important;
  height: auto !important;
  padding: 0 16px !important;
  margin: 0 !important;
  display: flex !important;
  justify-content: center !important;
  align-items: flex-start !important;
  visibility: visible !important;
  opacity: 1 !important;
  z-index: 2147483647 !important;
  pointer-events: none !important;
  transform: none !important;
  box-sizing: border-box !important;
}

/* Header content must receive clicks */
#hdr .navpill {
  pointer-events: auto !important;
}

/* =========================================================
   NAV PILL
   ========================================================= */

.navpill {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  width: 100%;
  max-width: var(--maxw, 1180px);
  padding: 8px 16px;
  border-radius: 999px;
  box-sizing: border-box;
}

/* =========================================================
   GLASS EFFECT
   ========================================================= */

.glass {
  background: rgba(255, 255, 255, 0.15);
  backdrop-filter: blur(20px) saturate(180%);
  -webkit-backdrop-filter: blur(20px) saturate(180%);
  border: 1px solid rgba(255, 255, 255, 0.3);
  box-shadow:
    0 8px 32px rgba(0, 0, 0, 0.1),
    inset 0 1px 1px rgba(255, 255, 255, 0.4);
}

/* =========================================================
   BRAND
   ========================================================= */

.brand {
  display: flex;
  align-items: center;
  gap: 10px;
  text-decoration: none;
  color: #000000;
  flex-shrink: 0;
}

.brand .mark svg {
  width: 28px;
  height: 28px;
  display: block;
}

.brand .txt {
  display: flex;
  flex-direction: column;
}

.brand .n1 {
  font-size: 15px;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
  color: #000000;
  line-height: 1;
}

.brand .n2 {
  font-size: 9px;
  letter-spacing: 0.14em;
  text-transform: uppercase;
  color: #000000;
  margin-top: 2px;
}

/* =========================================================
   MAIN NAVIGATION
   ========================================================= */

.nav {
  display: flex;
  align-items: center;
  gap: 22px;
  margin: 0 auto;
}

.nav a {
  color: #000000;
  text-decoration: none;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 0.1em;
  text-transform: uppercase;
  transition: opacity 0.25s ease;
  cursor: pointer;
  white-space: nowrap;
}

.nav a:hover {
  color: #000000;
  opacity: 0.7;
}

/* =========================================================
   NAV TOOLS
   ========================================================= */

.navtools {
  display: flex;
  align-items: center;
  gap: 8px;
  flex-shrink: 0;
}

/* =========================================================
   ICON BUTTON
   ========================================================= */

.ico {
  width: 38px;
  height: 38px;
  min-width: 38px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  position: relative;
  color: #000000;
  background: rgba(255, 255, 255, 0.15);
  border: 1px solid rgba(255, 255, 255, 0.3);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  text-decoration: none;
  cursor: pointer;
  padding: 0;
  margin: 0;
  transition:
    background 0.25s ease,
    transform 0.25s ease;
  box-sizing: border-box;
}

.ico:hover {
  background: rgba(255, 255, 255, 0.3);
  transform: translateY(-1px);
}

.ico svg {
  width: 18px;
  height: 18px;
}

/* =========================================================
   CART COUNT
   ========================================================= */

.ico .dot {
  position: absolute;
  top: 2px;
  right: 2px;
  background: var(--accent, #f0a03c);
  color: #000000;
  font-size: 9px;
  font-weight: 800;
  width: 15px;
  height: 15px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  line-height: 1;
}

/* =========================================================
   BURGER & MOBILE DRAWER
   ========================================================= */

.burger {
  display: none;
}

.mobile-drawer-overlay {
  position: fixed;
  inset: 0;
  background: rgba(0, 0, 0, 0.4);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  z-index: 2147483646;
  opacity: 0;
  visibility: hidden;
  transition: all 0.3s ease;
  pointer-events: auto;
}

.mobile-drawer-overlay.active {
  opacity: 1;
  visibility: visible;
}

.mobile-drawer {
  position: fixed;
  top: 0;
  right: -100%;
  width: 280px;
  max-width: 80vw;
  height: 100vh;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(25px) saturate(180%);
  -webkit-backdrop-filter: blur(25px) saturate(180%);
  border-left: 1px solid rgba(255, 255, 255, 0.4);
  box-shadow: -10px 0 30px rgba(0, 0, 0, 0.15);
  z-index: 2147483647;
  padding: 24px;
  display: flex;
  flex-direction: column;
  transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  box-sizing: border-box;
  pointer-events: auto;
}

.mobile-drawer.active {
  right: 0;
}

.drawer-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 32px;
}

.drawer-close {
  background: rgba(0, 0, 0, 0.05);
  border: none;
  width: 32px;
  height: 32px;
  border-radius: 50%;
  display: grid;
  place-items: center;
  cursor: pointer;
  color: #000;
}

.drawer-nav {
  display: flex;
  flex-direction: column;
  gap: 20px;
}

.drawer-nav a {
  color: #000000;
  text-decoration: none;
  font-size: 14px;
  font-weight: 800;
  letter-spacing: 0.12em;
  text-transform: uppercase;
}

.drawer-tools {
  margin-top: auto;
  padding-top: 20px;
  border-top: 1px solid rgba(0, 0, 0, 0.1);
  display: flex;
  gap: 12px;
}

/* =========================================================
   SIDE RAIL
   ========================================================= */

.rail {
  position: fixed !important;
  left: 20px !important;
  top: 50% !important;
  transform: translateY(-50%) !important;
  z-index: 2147483646 !important;
  display: flex;
  flex-direction: column;
  gap: 12px;
  margin: 0;
  padding: 0;
}

.rail a {
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: rgba(0, 0, 0, 0.2);
  border: 1px solid rgba(255, 255, 255, 0.4);
  backdrop-filter: blur(4px);
  -webkit-backdrop-filter: blur(4px);
  transition: all 0.3s ease;
  cursor: pointer;
  display: block;
}

.rail a:hover,
.rail a.on {
  background: #000000;
  border-color: #000000;
  transform: scale(1.4);
}

/* =========================================================
   FOCUS ACCESSIBILITY
   ========================================================= */

#hdr a:focus-visible,
#hdr button:focus-visible,
.rail a:focus-visible {
  outline: 2px solid #000000;
  outline-offset: 4px;
}

/* =========================================================
   TABLET / MOBILE
   ========================================================= */

@media (max-width: 900px) {
  .nav {
    display: none;
  }

  .burger {
    display: grid;
  }

  .hide-s {
    display: none;
  }

  .rail {
    display: none !important;
  }
}

/* =========================================================
   SMALL MOBILE
   ========================================================= */

@media (max-width: 600px) {
  #hdr {
    top: 10px !important;
    padding: 0 10px !important;
  }

  .navpill {
    padding: 7px 10px;
    gap: 8px;
  }

  .brand {
    gap: 7px;
  }

  .brand .mark svg {
    width: 25px;
    height: 25px;
  }

  .brand .n1 {
    font-size: 13px;
  }

  .brand .n2 {
    font-size: 8px;
  }

  .ico {
    width: 36px;
    height: 36px;
    min-width: 36px;
  }
}

/* =========================================================
   REDUCED MOTION
   ========================================================= */

@media (prefers-reduced-motion: reduce) {
  html {
    scroll-behavior: auto;
  }

  .ico,
  .rail a,
  .nav a,
  .mobile-drawer,
  .mobile-drawer-overlay {
    transition: none;
  }
}
</style>

<header id="hdr">
  <div class="navpill glass">
    <a class="brand" href="{{ routes.root_url }}" aria-label="Purelane home">
      <span class="mark">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="color:#b8701c">
          <path d="M12 3 20.5 8v8L12 21 3.5 16V8L12 3Z"/>
          <path d="M12 12 20.5 8M12 12v9M12 12 3.5 8"/>
        </svg>
      </span>

      <span class="txt">
        <span class="n1">{{ shop.name | default: "Purelane" }}</span>
        <span class="n2">Clean, simply</span>
      </span>
    </a>

    <nav class="nav" aria-label="Main">
      <a href="#top">Home</a>
      <a href="#ingredients">Ingredients</a>
      <a href="#how">How it works</a>
      <a href="#shop">Shop</a>
      <a href="#bundles">Bundles</a>
    </nav>

    <div class="navtools">
      <button
        class="ico hide-s"
        aria-label="Search"
        onclick="window.location.href='{{ routes.search_url }}'"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="11" cy="11" r="7"/>
          <path d="m20 20-3.5-3.5"/>
        </svg>
      </button>

      <a
        class="ico hide-s"
        aria-label="Account"
        href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
          <circle cx="12" cy="8" r="3.6"/>
          <path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>
        </svg>
      </a>

      <a
        class="ico"
        aria-label="Cart, {{ cart.item_count }} items"
        href="{{ routes.cart_url }}"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
          <path d="M4 6h2l2.2 10.4a1.6 1.6 0 0 0 1.6 1.3h7.6a1.6 1.6 0 0 0 1.6-1.3L20.5 9H6.4"/>
          <circle cx="10" cy="20.5" r="1.1"/>
          <circle cx="17.5" cy="20.5" r="1.1"/>
        </svg>

        <span class="dot">
          {{ cart.item_count }}
        </span>
      </a>

      <button
        class="ico burger"
        id="burgerBtn"
        aria-label="Menu"
      >
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
          <path d="M4 8h16M4 16h16"/>
        </svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile Navigation Drawer -->
<div class="mobile-drawer-overlay" id="drawerOverlay"></div>
<div class="mobile-drawer" id="mobileDrawer" aria-label="Mobile Menu">
  <div class="drawer-header">
    <span class="brand">
      <span class="txt">
        <span class="n1">{{ shop.name | default: "Purelane" }}</span>
      </span>
    </span>
    <button class="drawer-close" id="drawerClose" aria-label="Close Menu">✕</button>
  </div>
  <nav class="drawer-nav">
    <a href="#top">Home</a>
    <a href="#ingredients">Ingredients</a>
    <a href="#how">How it works</a>
    <a href="#shop">Shop</a>
    <a href="#bundles">Bundles</a>
  </nav>
  <div class="drawer-tools">
    <a class="ico" href="{{ routes.search_url }}" aria-label="Search">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <circle cx="11" cy="11" r="7"/>
        <path d="m20 20-3.5-3.5"/>
      </svg>
    </a>
    <a class="ico" href="{% if customer %}{{ routes.account_url }}{% else %}{{ routes.account_login_url }}{% endif %}" aria-label="Account">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round">
        <circle cx="12" cy="8" r="3.6"/>
        <path d="M5 20c0-3.6 3.1-5.6 7-5.6s7 2 7 5.6"/>
      </svg>
    </a>
  </div>
</div>

<nav class="rail" aria-label="Section progress">
  <a href="#top" class="on" aria-label="Hero"></a>
  <a href="#ingredients" aria-label="Ingredients"></a>
  <a href="#how" aria-label="How it works"></a>
  <a href="#proof" aria-label="Proof"></a>
  <a href="#bundles" aria-label="Bundles"></a>
  <a href="#shop" aria-label="Shop"></a>
  <a href="#voices" aria-label="Reviews"></a>
</nav>

<script>
(function () {

  /*
   * =========================================================
   * MOVE ELEMENTS TO BODY
   * Moves Header, Rail, Drawer, and Overlay directly under body
   * to bypass Theme/Dawn stacking context issues.
   * =========================================================
   */

  function movePurelaneHeaderToBody() {
    var header = document.getElementById('hdr');
    if (header && header.parentElement !== document.body) {
      document.body.appendChild(header);
    }

    var rail = document.querySelector('.rail');
    if (rail && rail.parentElement !== document.body) {
      document.body.appendChild(rail);
    }

    var drawer = document.getElementById('mobileDrawer');
    if (drawer && drawer.parentElement !== document.body) {
      document.body.appendChild(drawer);
    }

    var overlay = document.getElementById('drawerOverlay');
    if (overlay && overlay.parentElement !== document.body) {
      document.body.appendChild(overlay);
    }
  }

  movePurelaneHeaderToBody();

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', movePurelaneHeaderToBody);
  }

  window.addEventListener('load', movePurelaneHeaderToBody);

  /*
   * =========================================================
   * MOBILE DRAWER TOGGLE
   * =========================================================
   */

  function initializeMobileDrawer() {
    var burgerBtn = document.getElementById('burgerBtn');
    var drawerClose = document.getElementById('drawerClose');
    var drawer = document.getElementById('mobileDrawer');
    var overlay = document.getElementById('drawerOverlay');
    var drawerLinks = document.querySelectorAll('.drawer-nav a');

    function openDrawer() {
      if (drawer && overlay) {
        drawer.classList.add('active');
        overlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      }
    }

    function closeDrawer() {
      if (drawer && overlay) {
        drawer.classList.remove('active');
        overlay.classList.remove('active');
        document.body.style.overflow = '';
      }
    }

    if (burgerBtn) {
      burgerBtn.addEventListener('click', openDrawer);
    }

    if (drawerClose) {
      drawerClose.addEventListener('click', closeDrawer);
    }

    if (overlay) {
      overlay.addEventListener('click', closeDrawer);
    }

    drawerLinks.forEach(function (link) {
      link.addEventListener('click', closeDrawer);
    });
  }

  /*
   * =========================================================
   * SMOOTH NAVIGATION
   * =========================================================
   */

  function initializeNavigation() {
    var anchors = document.querySelectorAll(
      '#hdr a[href^="#"], .rail a[href^="#"], .drawer-nav a[href^="#"]'
    );

    anchors.forEach(function (anchor) {
      if (anchor.dataset.purelaneNavigation === 'true') {
        return;
      }

      anchor.dataset.purelaneNavigation = 'true';

      anchor.addEventListener('click', function (e) {
        var targetId = this.getAttribute('href');

        if (!targetId || targetId === '#') {
          return;
        }

        var targetElement = document.querySelector(targetId);

        if (targetElement) {
          e.preventDefault();
          targetElement.scrollIntoView({
            behavior: 'smooth',
            block: 'start'
          });
        }
      });
    });
  }

  /*
   * =========================================================
   * RAIL DOT ACTIVE STATE
   * =========================================================
   */

  function initializeRailObserver() {
    var railLinks = document.querySelectorAll('.rail a');
    var sections = document.querySelectorAll('section[id], div[id]');

    if (!railLinks.length || !sections.length) {
      return;
    }

    var observer = new IntersectionObserver(
      function (entries) {
        entries.forEach(function (entry) {
          if (!entry.isIntersecting) {
            return;
          }

          var id = entry.target.getAttribute('id');

          railLinks.forEach(function (dot) {
            dot.classList.toggle(
              'on',
              dot.getAttribute('href') === '#' + id
            );
          });
        });
      },
      {
        threshold: 0.3
      }
    );

    sections.forEach(function (section) {
      observer.observe(section);
    });
  }

  /*
   * Initialize All Features
   */

  function initAll() {
    initializeMobileDrawer();
    initializeNavigation();
    if ('IntersectionObserver' in window) {
      initializeRailObserver();
    }
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initAll);
  } else {
    initAll();
  }

})();
</script>

