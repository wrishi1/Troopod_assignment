<div class="purelane-shop-grid section-{{ section.id }}" id="shop">
  <div class="wrap">
    <div class="panel-head text-center">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="products-grid">
      {%- assign collection = collections[section.settings.collection] -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <div class="product-card">
            <div class="card-image-wrap">
              {%- if product.compare_at_price > product.price -%}
                <span class="badge sale-badge">Sale</span>
              {%- endif -%}
              <a href="{{ product.url }}">
                {%- if product.featured_media -%}
                  <img src="{{ product.featured_media | image_url: width: 600 }}" alt="{{ product.featured_media.alt | escape }}" loading="lazy" width="300" height="300">
                {%- else -%}
                  {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
                {%- endif -%}
              </a>
            </div>

            <div class="card-content">
              <span class="product-vendor">{{ product.vendor }}</span>
              <h3 class="product-title">
                <a href="{{ product.url }}">{{ product.title }}</a>
              </h3>
              
              <div class="price-wrap">
                <span class="price">{{ product.price | money }}</span>
                {%- if product.compare_at_price > product.price -%}
                  <span class="compare-price">{{ product.compare_at_price | money }}</span>
                {%- endif -%}
              </div>

              <form method="post" action="/cart/add" class="add-to-cart-form">
                <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
                <button type="submit" class="btn-add-cart" {% unless product.available %}disabled{% endunless %}>
                  {%- if product.available -%}
                    Add to Cart
                  {%- else -%}
                    Sold Out
                  {%- endif -%}
                </button>
              </form>
            </div>
          </div>
        {%- endfor -%}
      {%- else -%}
        {%- for i in (1..4) -%}
          <div class="product-card">
            <div class="card-image-wrap">
              {{ 'product-' | append: i | placeholder_svg_tag: 'placeholder-svg' }}
            </div>
            <div class="card-content">
              <span class="product-vendor">Purelane</span>
              <h3 class="product-title"><a href="#">Sample Eco Product {{ i }}</a></h3>
              <div class="price-wrap">
                <span class="price">$19.99</span>
              </div>
              <button class="btn-add-cart" disabled>Add to Cart</button>
            </div>
          </div>
        {%- endfor -%}
      {%- endif -%}
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }} {
    padding: 80px 0;
    position: relative;
    background: transparent;
  }

  .section-{{ section.id }} .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .section-{{ section.id }} .panel-head {
    text-align: center;
    margin-bottom: 50px;
  }

  .section-{{ section.id }} .kicker {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #2e7d32;
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
  }

  .section-{{ section.id }} h2.d2 {
    font-size: 32px;
    font-weight: 800;
    margin: 0;
    color: #111311;
    letter-spacing: -0.5px;
  }

  /* Grid Layout */
  .section-{{ section.id }} .products-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 28px;
  }

  /* Glassmorphism Product Card */
  .section-{{ section.id }} .product-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 20px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.04),
                0 1px 3px rgba(0, 0, 0, 0.02);
    overflow: hidden;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .section-{{ section.id }} .product-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.08);
    border-color: rgba(46, 125, 50, 0.2);
    background: rgba(255, 255, 255, 0.95);
  }

  /* Card Image */
  .section-{{ section.id }} .card-image-wrap {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background: rgba(0, 0, 0, 0.02);
    overflow: hidden;
  }

  .section-{{ section.id }} .card-image-wrap img,
  .section-{{ section.id }} .card-image-wrap .placeholder-svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .section-{{ section.id }} .product-card:hover .card-image-wrap img {
    transform: scale(1.05);
  }

  .section-{{ section.id }} .badge.sale-badge {
    position: absolute;
    top: 14px;
    left: 14px;
    z-index: 2;
    background: #2e7d32;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    padding: 4px 10px;
    border-radius: 20px;
    letter-spacing: 0.5px;
  }

  /* Card Details */
  .section-{{ section.id }} .card-content {
    padding: 20px;
    display: flex;
    flex-direction: column;
    flex-grow: 1;
  }

  .section-{{ section.id }} .product-vendor {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 1px;
    color: #666;
    margin-bottom: 4px;
  }

  .section-{{ section.id }} .product-title {
    font-size: 16px;
    font-weight: 700;
    margin: 0 0 10px;
    line-height: 1.3;
  }

  .section-{{ section.id }} .product-title a {
    color: #111311;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .section-{{ section.id }} .product-title a:hover {
    color: #2e7d32;
  }

  .section-{{ section.id }} .price-wrap {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-bottom: 16px;
    margin-top: auto;
  }

  .section-{{ section.id }} .price {
    font-size: 16px;
    font-weight: 800;
    color: #111311;
  }

  .section-{{ section.id }} .compare-price {
    font-size: 13px;
    color: #888;
    text-decoration: line-through;
  }

  /* Add to Cart Button */
  .section-{{ section.id }} .btn-add-cart {
    width: 100%;
    padding: 12px;
    background: #111311;
    color: #ffffff;
    border: none;
    border-radius: 12px;
    font-size: 14px;
    font-weight: 600;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .section-{{ section.id }} .btn-add-cart:hover:not([disabled]) {
    background: #2e7d32;
    transform: translateY(-1px);
    box-shadow: 0 4px 12px rgba(46, 125, 50, 0.25);
  }

  .section-{{ section.id }} .btn-add-cart[disabled] {
    background: #ccc;
    cursor: not-allowed;
  }

  @media (max-width: 768px) {
    .section-{{ section.id }} {
      padding: 50px 0;
    }

    .section-{{ section.id }} .products-grid {
      grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
      gap: 16px;
    }

    .section-{{ section.id }} .card-content {
      padding: 14px;
    }

    .section-{{ section.id }} .product-title {
      font-size: 14px;
    }
  }
</style>

{% schema %}
{
  "name": "Purelane Shop Grid",
  "tag": "section",
  "class": "purelane-shop-grid-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Subheading",
      "default": "Pure & Effective"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Explore Our Collection"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8,
      "label": "Products to show"
    }
  ],
  "presets": [
    {
      "name": "Purelane Shop Grid"
    }
  ]
}
{% endschema %}