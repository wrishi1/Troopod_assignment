<section class="sec" id="shop" data-scene="3">
  <div class="wrap">
    <div class="panel-head rv">
      <span class="kicker">Bestsellers</span>
      <h2 class="d2" style="margin-top:12px">Loved by 30,000 homes</h2>
      <div class="rule">
        <i></i>
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21c0-6.5 3.5-11 8-12.5C20 15 16.5 20 12 21Z"/><path d="M12 21C12 14.5 8.5 10 4 8.5 4 15 7.5 20 12 21Z"/></svg>
        <i></i>
      </div>
    </div>
    
    <div class="shelf">
      {% comment %} Replace 'all' with your specific collection handle if needed {% endcomment %}
      {% for product in collections.all.products limit: 8 %}
        <article class="glass card rv">
          <div class="shot">
            {% if product.tags contains 'Bestseller' or product.tags contains 'bestseller' %}
              <span class="pill">Best seller</span>
            {% elsif product.tags contains 'New' or product.tags contains 'new' %}
              <span class="pill">New</span>
            {% else %}
              <span class="pill">Top rated</span>
            {% endif %}

            {% if product.featured_media %}
              <img src="{{ product.featured_media | image_url: width: 300 }}" alt="{{ product.title | escape }}" loading="lazy" style="height:110px; width:auto; object-fit:contain;">
            {% else %}
              <span class="pimg p-tap" role="img" aria-label="{{ product.title | escape }}"></span>
            {% endif %}
          </div>

          <h4>{{ product.title }}</h4>
          
          <div class="rate"><b>★ 4.8</b> · 200+ reviews</div>

          <div class="pr">
            <strong>{{ product.price | money }}</strong>
            {% if product.compare_at_price > product.price %}
              <s>{{ product.compare_at_price | money }}</s>
              <em>
                {% assign savings = product.compare_at_price | minus: product.price | times: 100.0 | divided_by: product.compare_at_price | round %}
                {{ savings }}% off
              </em>
            {% endif %}
          </div>

          {% form 'product', product, class: 'shopify-product-form' %}
            <input type="hidden" name="id" value="{{ product.selected_or_first_available_variant.id }}">
            <button type="submit" class="btn btn-ghost btn-sm add-to-cart-btn" {% unless product.available %}disabled{% endunless %}>
              {% if product.available %}Add to cart{% else %}Sold out{% endif %}
            </button>
          {% endform %}
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
:root {
  --sec-bg: #cbe6d7;
  --card-bg: rgba(238, 246, 242, 0.75);
  --card-border: rgba(255, 255, 255, 0.85);
  --text-dark: #1b2621;
  --text-muted: #64756b;
  --accent-gold: #c67d26;
  --accent-green: #386652;
  --btn-dark: #074e40;
}

/* Base Section Alignment & Wavy Soft Background */
.sec {
  background-color: var(--sec-bg);
  background-image: radial-gradient(circle at 50% 50%, rgba(255, 255, 255, 0.45) 0%, transparent 65%);
  padding: 48px 16px;
  font-family: 'Inter', system-ui, -apple-system, sans-serif;
  color: var(--text-dark);
}

.wrap {
  max-width: 1080px;
  margin: 0 auto;
}

/* Header Adjustments Matching Visual Design */
.panel-head {
  text-align: center;
  margin-bottom: 32px;
}

.kicker {
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 0.22em;
  text-transform: uppercase;
  color: var(--text-muted);
}

.d2 {
  font-family: 'Outfit', sans-serif;
  font-weight: 800;
  font-size: 36px;
  letter-spacing: -0.01em;
  color: var(--text-dark);
  text-transform: uppercase;
  margin-top: 8px !important;
}

/* Perfect Horizontal Alignment for Rule Element */
.rule {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16px;
  margin-top: 14px;
}

.rule i {
  height: 1px;
  width: 140px;
  background: linear-gradient(90deg, transparent, rgba(56, 102, 82, 0.35) 50%, transparent);
  display: block;
}

.rule svg {
  width: 18px;
  height: 18px;
  color: var(--accent-gold);
  flex-shrink: 0;
}

/* Shelf Grid Setup */
.shelf {
  display: grid;
  gap: 16px;
  grid-template-columns: repeat(2, 1fr);
}

@media (min-width: 860px) {
  .shelf {
    grid-template-columns: repeat(4, 1fr);
  }
}

/* Card Glassmorphism & Hover Animations */
.card {
  padding: 16px;
  display: flex;
  flex-direction: column;
  background: var(--card-bg) !important;
  backdrop-filter: blur(16px) saturate(140%) !important;
  -webkit-backdrop-filter: blur(16px) saturate(140%) !important;
  border: 1.5px solid var(--card-border) !important;
  border-radius: 20px !important;
  box-shadow: 0 10px 24px rgba(27, 38, 33, 0.04) !important;
  transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
              box-shadow 0.35s cubic-bezier(0.16, 1, 0.3, 1), 
              background-color 0.35s ease, 
              border-color 0.35s ease;
  will-change: transform, box-shadow;
}

.card:hover {
  transform: translateY(-8px) scale(1.015);
  background: rgba(246, 252, 248, 0.92) !important;
  border-color: rgba(255, 255, 255, 1) !important;
  box-shadow: 0 20px 40px rgba(27, 38, 33, 0.1), 0 0 0 1px rgba(198, 125, 38, 0.2) !important;
}

/* Product Preview Glass Surface */
.card .shot {
  height: 140px;
  border-radius: 14px;
  margin-bottom: 14px;
  display: grid;
  place-items: center;
  position: relative;
  overflow: hidden;
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.65), rgba(210, 230, 220, 0.45));
  border: 1px solid rgba(255, 255, 255, 0.7);
  transition: transform 0.35s ease, background 0.35s ease;
}

.card:hover .shot {
  background: linear-gradient(160deg, rgba(255, 255, 255, 0.85), rgba(210, 230, 220, 0.6));
}

.card .shot svg,
.card .shot img,
.card .shot .pimg {
  height: 110px;
  width: auto;
  filter: drop-shadow(0 6px 10px rgba(0, 74, 66, 0.12));
  transition: transform 0.35s ease;
}

.card:hover .shot svg,
.card:hover .shot img,
.card:hover .shot .pimg {
  transform: scale(1.06);
}

/* Pill Tag Styling */
.card .pill {
  position: absolute;
  top: 8px;
  left: 8px;
  font-size: 9px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  padding: 4px 10px;
  border-radius: 999px;
  background: rgba(255, 255, 255, 0.9);
  border: 1px solid rgba(198, 125, 38, 0.35);
  color: var(--accent-gold);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  z-index: 2;
}

/* Card Content Styling */
.card h4 {
  font-family: 'Outfit', sans-serif;
  font-size: 13px;
  font-weight: 700;
  text-transform: uppercase;
  letter-spacing: 0.02em;
  color: var(--text-dark);
  line-height: 1.3;
  margin-bottom: 6px;
}

.card .rate {
  font-size: 11px;
  color: var(--text-muted);
  margin-bottom: 12px;
  display: flex;
  align-items: center;
  gap: 4px;
}

.card .rate b {
  color: var(--accent-gold);
  font-weight: 700;
}

.card .pr {
  margin-top: auto;
  display: flex;
  align-items: baseline;
  gap: 6px;
  margin-bottom: 12px;
}

.card .pr strong {
  font-family: 'Outfit', sans-serif;
  font-size: 18px;
  color: var(--text-dark);
  font-weight: 800;
}

.card .pr s {
  font-size: 12px;
  color: var(--text-muted);
}

.card .pr em {
  font-style: normal;
  font-size: 10px;
  font-weight: 800;
  letter-spacing: 0.06em;
  color: var(--accent-gold);
}

/* Action Button & Hover Transitions */
.card .shopify-product-form {
  margin: 0;
  width: 100%;
}

.card .btn {
  width: 100%;
  padding: 10px 14px;
  font-size: 10.5px;
  font-weight: 700;
  letter-spacing: 0.12em;
  text-transform: uppercase;
  border-radius: 999px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  text-decoration: none;
  background: rgba(255, 255, 255, 0.85);
  color: var(--text-dark);
  border: 1px solid rgba(255, 255, 255, 0.9);
  box-shadow: 0 2px 6px rgba(0, 0, 0, 0.03);
  transition: all 0.25s ease;
  cursor: pointer;
}

.card:hover .btn,
.card .btn:hover {
  background: var(--btn-dark);
  color: #ffffff;
  border-color: var(--btn-dark);
  box-shadow: 0 4px 12px rgba(7, 78, 64, 0.25);
}

/* Mobile Tweaks */
@media (max-width: 760px) {
  .card .shot { height: 120px; }
  .card .shot svg, .card .shot img, .card .shot .pimg { height: 95px; }
  .shelf { gap: 12px; }
  .rule i { width: 80px; }
}
{% endstylesheet %}

{% schema %}
{
  "name": "Purelane Shop",
  "settings": [],
  "presets": [
    { "name": "Purelane Shop" }
  ]
}
{% endschema %}

<script>
document.addEventListener('DOMContentLoaded', () => {
  const forms = document.querySelectorAll('.shopify-product-form');

  forms.forEach(form => {
    form.addEventListener('submit', async (e) => {
      e.preventDefault();

      const button = form.querySelector('.add-to-cart-btn');
      const variantInput = form.querySelector('input[name="id"]');
      
      if (!variantInput || !variantInput.value) {
        console.error('Variant ID missing');
        return;
      }

      const originalText = button.textContent;
      button.textContent = 'Adding...';
      button.disabled = true;

      try {
        const response = await fetch('/cart/add.js', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            'Accept': 'application/json'
          },
          body: JSON.stringify({
            items: [{
              id: parseInt(variantInput.value, 10),
              quantity: 1
            }]
          })
        });

        const data = await response.json();

        if (response.ok) {
          button.textContent = 'Added! ✓';

          // Broadcast events for theme drawers/carts (Dawn, Impulse, Sense, etc.)
          document.dispatchEvent(new CustomEvent('cart:refresh', { bubbles: true }));
          document.dispatchEvent(new CustomEvent('product:added', { bubbles: true }));

          // Redirect to cart page after 800ms if theme has no ajax drawer built-in
          setTimeout(() => {
            window.location.href = '/cart';
          }, 800);
        } else {
          console.error('Shopify Cart Error:', data.description || data.message);
          button.textContent = 'Error!';
          setTimeout(() => {
            button.textContent = originalText;
            button.disabled = false;
          }, 2000);
        }
      } catch (error) {
        console.error('Network Error:', error);
        button.textContent = 'Error!';
        setTimeout(() => {
          button.textContent = originalText;
          button.disabled = false;
        }, 2000);
      }
    });
  });
});
</script>