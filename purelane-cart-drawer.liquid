<div class="cart-drawer-overlay" id="CartDrawerOverlay"></div>
<div class="cart-drawer" id="CartDrawer" aria-hidden="true">
  <div class="cart-drawer-header">
    <h3>Your Shopping Cart (<span id="CartDrawerCount">{{ cart.item_count }}</span>)</h3>
    <button type="button" class="cart-drawer-close" id="CartDrawerClose" aria-label="Close cart">&times;</button>
  </div>

  <div class="cart-drawer-body" id="CartDrawerBody">
    {%- if cart.item_count > 0 -%}
      <div class="cart-drawer-items">
        {%- for item in cart.items -%}
          <div class="cart-drawer-item" data-line-key="{{ item.key }}">
            <div class="cart-item-img">
              {%- if item.image -%}
                <img src="{{ item.image | image_url: width: 120 }}" alt="{{ item.title | escape }}" loading="lazy">
              {%- else -%}
                {{ 'product-1' | placeholder_svg_tag: 'placeholder-svg' }}
              {%- endif -%}
            </div>
            <div class="cart-item-details">
              <span class="cart-item-title">{{ item.product.title | escape }}</span>
              <span class="cart-item-variant">{{ item.variant.title }}</span>
              <div class="cart-item-price">{{ item.final_line_price | money }}</div>
              <div class="cart-item-qty">
                <span>Qty: {{ item.quantity }}</span>
              </div>
            </div>
          </div>
        {%- endfor -%}
      </div>
    {%- else -%}
      <div class="cart-drawer-empty">
        <p>Your cart is currently empty.</p>
      </div>
    {%- endif -%}
  </div>

  <div class="cart-drawer-footer">
    <div class="cart-subtotal">
      <span>Subtotal</span>
      <strong id="CartDrawerSubtotal">{{ cart.total_price | money }}</strong>
    </div>
    <p class="shipping-note">Taxes and shipping calculated at checkout.</p>
    <a href="/checkout" class="btn btn-primary checkout-btn">Proceed to Checkout</a>
  </div>
</div>

<style>
  .cart-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100vw;
    height: 100vh;
    background: rgba(0, 0, 0, 0.4);
    backdrop-filter: blur(4px);
    z-index: 9998;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
  }
  .cart-drawer-overlay.active {
    opacity: 1;
    visibility: visible;
  }
  .cart-drawer {
    position: fixed;
    top: 0;
    right: -420px;
    width: 100%;
    max-width: 400px;
    height: 100vh;
    background: #ffffff;
    z-index: 9999;
    box-shadow: -8px 0 24px rgba(0, 0, 0, 0.12);
    display: flex;
    flex-direction: column;
    transition: right 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .cart-drawer.active {
    right: 0;
  }
  .cart-drawer-header {
    padding: 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .cart-drawer-header h3 {
    margin: 0;
    font-size: 18px;
    font-weight: 700;
  }
  .cart-drawer-close {
    background: none;
    border: none;
    font-size: 28px;
    cursor: pointer;
    line-height: 1;
    color: #555;
  }
  .cart-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }
  .cart-drawer-item {
    display: flex;
    gap: 16px;
    margin-bottom: 16px;
    padding-bottom: 16px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }
  .cart-item-img {
    width: 70px;
    height: 70px;
    background: #f7f7f7;
    border-radius: 8px;
    overflow: hidden;
    flex-shrink: 0;
  }
  .cart-item-img img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }
  .cart-item-details {
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
  }
  .cart-item-title {
    font-weight: 600;
    font-size: 14px;
    color: #111;
  }
  .cart-item-variant {
    font-size: 12px;
    color: #666;
  }
  .cart-item-price {
    font-size: 14px;
    font-weight: 700;
  }
  .cart-item-qty {
    font-size: 12px;
    color: #777;
  }
  .cart-drawer-empty {
    text-align: center;
    padding: 40px 0;
    color: #777;
  }
  .cart-drawer-footer {
    padding: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.08);
    background: #fafafa;
  }
  .cart-subtotal {
    display: flex;
    justify-content: space-between;
    font-size: 16px;
    margin-bottom: 6px;
  }
  .shipping-note {
    font-size: 12px;
    color: #666;
    margin: 0 0 16px;
  }
  .checkout-btn {
    display: block;
    width: 100%;
    text-align: center;
    padding: 12px;
    background: #111;
    color: #fff;
    text-decoration: none;
    border-radius: 8px;
    font-weight: 600;
  }
</style>

{% schema %}
{
  "name": "Purelane Cart Drawer",
  "tag": "section",
  "class": "purelane-cart-drawer-section",
  "settings": [],
  "presets": [
    {
      "name": "Purelane Cart Drawer"
    }
  ]
}
{% endschema %}
<script>
  document.addEventListener('DOMContentLoaded', function() {
    const drawer = document.getElementById('CartDrawer');
    const overlay = document.getElementById('CartDrawerOverlay');
    const closeBtn = document.getElementById('CartDrawerClose');

    // Function to open drawer
    function openCartDrawer() {
      if (drawer) drawer.classList.add('active');
      if (overlay) overlay.classList.add('active');
    }

    // Function to close drawer
    function closeCartDrawer() {
      if (drawer) drawer.classList.remove('active');
      if (overlay) overlay.classList.remove('active');
    }

    if (closeBtn) closeBtn.addEventListener('click', closeCartDrawer);
    if (overlay) overlay.addEventListener('click', closeCartDrawer);

    // Single Product Add to Cart Logic
    document.querySelectorAll('.ajax-add-to-cart').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const variantId = this.getAttribute('data-variant-id');
        if (!variantId) return;

        button.innerText = 'Adding...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ items: [{ id: variantId, quantity: 1 }] })
        })
        .then(response => response.json())
        .then(data => {
          button.innerText = 'Add to Cart';
          // Refresh page or open drawer to display updated cart
          window.location.reload(); 
        })
        .catch(error => {
          console.error('Error adding to cart:', error);
          button.innerText = 'Add to Cart';
        });
      });
    });

    // Combo Bundle Add to Cart Logic
    document.querySelectorAll('.bundle-add').forEach(button => {
      button.addEventListener('click', function(e) {
        e.preventDefault();
        const v1 = this.getAttribute('data-v1');
        const v2 = this.getAttribute('data-v2');

        if (!v1 || !v2) return;

        button.innerText = 'Adding Bundle...';

        fetch('/cart/add.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            items: [
              { id: v1, quantity: 1 },
              { id: v2, quantity: 1 }
            ]
          })
        })
        .then(response => response.json())
        .then(data => {
          button.innerText = 'Add Combo to Cart';
          window.location.reload();
        })
        .catch(error => {
          console.error('Error adding bundle:', error);
          button.innerText = 'Add Combo to Cart';
        });
      });
    });
  });
</script>