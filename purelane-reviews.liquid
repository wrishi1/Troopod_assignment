<div class="purelane-reviews section-{{ section.id }}" id="reviews">
  <div class="wrap">
    <div class="panel-head text-center">
      {%- if section.settings.kicker != blank -%}
        <span class="kicker">{{ section.settings.kicker | escape }}</span>
      {%- endif -%}
      {%- if section.settings.heading != blank -%}
        <h2 class="d2">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
    </div>

    <div class="reviews-grid">
      {%- for block in section.blocks -%}
        <div class="review-card" {{ block.shopify_attributes }}>
          <div class="stars">★★★★★</div>
          <p class="review-text">"{{ block.settings.review_text | escape }}"</p>
          <div class="author-info">
            <strong>{{ block.settings.author_name | escape }}</strong>
            {%- if block.settings.verified -%}
              <span class="verified-badge">✓ Verified Buyer</span>
            {%- endif -%}
          </div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</div>

<style>
  .section-{{ section.id }} {
    padding: 80px 0;
    position: relative;
    background: transparent;
  }
  
  .section-{{ section.id }} .wrap {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0 20px;
    position: relative;
    z-index: 1;
  }
  
  .section-{{ section.id }} .panel-head {
    text-align: center;
    margin-bottom: 50px;
  }
  
  .section-{{ section.id }} .kicker {
    font-size: 13px;
    text-transform: uppercase;
    letter-spacing: 1.5px;
    color: #2e7d32;
    display: block;
    margin-bottom: 8px;
    font-weight: 700;
  }
  
  .section-{{ section.id }} h2.d2 {
    font-size: 32px;
    font-weight: 800;
    margin: 0;
    color: #111311;
    letter-spacing: -0.5px;
  }
  
  .section-{{ section.id }} .reviews-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
    gap: 28px;
  }
  
  /* Modern Glassmorphism Card Styling */
  .section-{{ section.id }} .review-card {
    background: rgba(255, 255, 255, 0.85);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-radius: 20px;
    padding: 32px;
    border: 1px solid rgba(255, 255, 255, 0.9);
    box-shadow: 0 12px 32px rgba(0, 0, 0, 0.04),
                0 1px 3px rgba(0, 0, 0, 0.02);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .section-{{ section.id }} .review-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 20px 40px rgba(0, 0, 0, 0.07);
    border-color: rgba(46, 125, 50, 0.15);
    background: rgba(255, 255, 255, 0.95);
  }
  
  .section-{{ section.id }} .stars {
    color: #f59e0b;
    font-size: 16px;
    letter-spacing: 2px;
    margin-bottom: 16px;
  }
  
  .section-{{ section.id }} .review-text {
    font-size: 15px;
    line-height: 1.6;
    color: #333933;
    margin: 0 0 24px;
    font-style: italic;
  }
  
  .section-{{ section.id }} .author-info {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 14px;
    border-top: 1px solid rgba(0, 0, 0, 0.04);
    padding-top: 16px;
  }

  .section-{{ section.id }} .author-info strong {
    color: #111311;
    font-weight: 700;
  }
  
  .section-{{ section.id }} .verified-badge {
    color: #2e7d32;
    font-size: 12px;
    font-weight: 600;
    background: rgba(46, 125, 50, 0.08);
    padding: 4px 10px;
    border-radius: 20px;
  }

  @media (max-width: 768px) {
    .section-{{ section.id }} {
      padding: 50px 0;
    }
    .section-{{ section.id }} h2.d2 {
      font-size: 26px;
    }
  }
</style>

{% schema %}
{
  "name": "Purelane Reviews",
  "tag": "section",
  "class": "purelane-reviews-section",
  "settings": [
    {
      "type": "text",
      "id": "kicker",
      "label": "Subheading",
      "default": "Loved by Thousands"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "What Our Customers Say"
    }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Customer Review",
      "settings": [
        {
          "type": "textarea",
          "id": "review_text",
          "label": "Review Quote",
          "default": "The plant-based dish soap cuts through tough grease effortlessly. Smells clean and fresh without harsh chemical odors!"
        },
        {
          "type": "text",
          "id": "author_name",
          "label": "Customer Name",
          "default": "Priya S."
        },
        {
          "type": "checkbox",
          "id": "verified",
          "label": "Show Verified Buyer Badge",
          "default": true
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        {
          "type": "review",
          "settings": {
            "review_text": "The plant-based dish soap cuts through tough grease effortlessly. Smells clean and fresh without harsh chemical odors!",
            "author_name": "Priya S.",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "Switching to Purelane was the best decision for my kitchen. Gentle on hands and super effective!",
            "author_name": "Rahul M.",
            "verified": true
          }
        },
        {
          "type": "review",
          "settings": {
            "review_text": "The combo bundle is incredible value for money. Highly recommend to anyone looking for safe homecare solutions.",
            "author_name": "Ananya K.",
            "verified": true
          }
        }
      ]
    }
  ]
}
{% endschema %}