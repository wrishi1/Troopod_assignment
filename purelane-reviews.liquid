<section class="sec revband" id="reviews" data-scene="1">
  <div class="wrap">
    <div class="revhead rv">
      <span class="kicker">{{ section.settings.kicker | default: "That's what they said" }}</span>
      <span class="agg"><span class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</span> <b>{{ section.settings.rating | default: "4.8" }}</b> from {{ section.settings.review_count | default: "8,000+" }} reviews</span>
      <span class="agg">Loved by <b>{{ section.settings.homes_count | default: "12 lakh+" }}</b> homes</span>
    </div>
  </div>
  <div class="revrail rv" aria-label="Customer reviews">
    <div class="revtrack">
      {% for block in section.blocks %}
        <article class="glass-2 rcard" {{ block.shopify_attributes }}>
          <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.body }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author }}</b><span>&middot; {{ block.settings.product }}</span>
          </div>
        </article>
      {% endfor %}
      {% comment %} duplicate the set once so the CSS marquee (which scrolls to -50%) loops seamlessly {% endcomment %}
      {% for block in section.blocks %}
        <article class="glass-2 rcard" aria-hidden="true">
          <div class="st">&#9733;&#9733;&#9733;&#9733;&#9733;</div>
          <h5>{{ block.settings.title }}</h5>
          <p>{{ block.settings.body }}</p>
          <div class="who">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><path d="m5 13 4 4L19 7"/></svg>
            <b>{{ block.settings.author }}</b><span>&middot; {{ block.settings.product }}</span>
          </div>
        </article>
      {% endfor %}
    </div>
  </div>
</section>

{% stylesheet %}
/* ---------- REVIEW MARQUEE (below hero) ---------- */
.revband{padding:var(--sec-y) 0}
.revhead{display:flex;align-items:center;justify-content:center;gap:10px 18px;flex-wrap:wrap;margin-bottom:14px}
.revhead .agg{display:inline-flex;align-items:center;gap:8px;font-size:11.5px;font-weight:700;letter-spacing:.14em;text-transform:uppercase;color:var(--paper-2)}
.revhead .agg b{font-family:'Outfit',sans-serif;font-size:16px;color:var(--accent);letter-spacing:0}
.revhead .st{color:var(--accent);font-size:12px;letter-spacing:.16em}
.revrail{overflow:hidden;position:relative;
  -webkit-mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent);
  mask-image:linear-gradient(90deg,transparent,#000 7%,#000 93%,transparent)}
.revtrack{display:flex;gap:12px;width:max-content;animation:marq 52s linear infinite}
.revrail:hover .revtrack,.revrail:focus-within .revtrack{animation-play-state:paused}
@keyframes marq{from{transform:translate3d(0,0,0)}to{transform:translate3d(-50%,0,0)}}
.rcard{flex:0 0 auto;width:284px;padding:15px 17px;border-radius:18px}
.rcard .st{color:var(--accent);font-size:10.5px;letter-spacing:.2em;margin-bottom:9px}
.rcard h5{font-family:'Outfit',sans-serif;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:.05em;color:var(--surface);margin-bottom:7px}
.rcard p{font-size:12.6px;color:var(--paper-2);line-height:1.52;margin-bottom:11px}
.rcard .who{display:flex;align-items:center;gap:7px;font-size:9.5px;font-weight:700;letter-spacing:.12em;text-transform:uppercase;color:var(--paper-3)}
.rcard .who b{color:var(--surface);font-weight:700}
.rcard .who svg{width:12px;height:12px;color:var(--accent);flex:0 0 auto}

/* mobile tweak (from the MOBILE TWEAKS FOR NEW SECTIONS block) */
@media(max-width:760px){
  .rcard{width:250px;padding:13px 14px}
  .revtrack{animation-duration:40s}
}

/* ---------- V2 brand-colour overrides for reviews ---------- */
.revhead .st,.rcard .st{color:#7a9c1e}
.rcard .who b{color:#01423b}
.rcard .who svg{color:#4f7d10}
{% endstylesheet %}

{% schema %}
{
  "name": "Purelane Reviews",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Kicker", "default": "That's what they said" },
    { "type": "text", "id": "rating", "label": "Aggregate rating", "default": "4.8" },
    { "type": "text", "id": "review_count", "label": "Review count text", "default": "8,000+" },
    { "type": "text", "id": "homes_count", "label": "Homes count text", "default": "12 lakh+" }
  ],
  "blocks": [
    {
      "type": "review",
      "name": "Review",
      "settings": [
        { "type": "text", "id": "title", "label": "Title", "default": "Works like a charm" },
        { "type": "textarea", "id": "body", "label": "Review text", "default": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better." },
        { "type": "text", "id": "author", "label": "Author", "default": "Anita" },
        { "type": "text", "id": "product", "label": "Product", "default": "Laundry detergent" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Purelane Reviews",
      "blocks": [
        { "type": "review", "settings": { "title": "Works like a charm", "body": "Finally an eco option that cleans as well as the chemical detergent I used for years, and it smells better.", "author": "Anita", "product": "Laundry detergent" } },
        { "type": "review", "settings": { "title": "Best dishwash ever", "body": "Our old dishwash left my help with dry, cracked skin. That stopped completely after we switched.", "author": "Priya", "product": "Dishwash gel" } },
        { "type": "review", "settings": { "title": "Great product, great packaging", "body": "Very soft on hands with a lovely fragrance, and it feels good to be using far less plastic.", "author": "Sunita", "product": "Liquid handwash" } },
        { "type": "review", "settings": { "title": "Dog friendly", "body": "We switched because chemical floor cleaners were setting off my dog's allergies. No reactions since.", "author": "Rohit S.", "product": "Floor cleaner" } },
        { "type": "review", "settings": { "title": "Sparkling taps again", "body": "Hard water had ruined our bathroom fittings. Two sprays and the scale wipes straight off, no scrubbing.", "author": "Verified buyer", "product": "Tap cleaner" } }
      ]
    }
  ]
}
{% endschema %}
